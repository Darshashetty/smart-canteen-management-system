# ─── Frontend (Next.js) environment ─────────────────────────────
# Leave both public URLs empty to use same-origin requests. Next.js then
# proxies /api and /socket.io to BACKEND_URL, so a phone opening the app over
# a LAN IP or dev tunnel reaches the backend without any extra public URL.
#   NEXT_PUBLIC_API_URL=
#   NEXT_PUBLIC_SOCKET_URL=
#   BACKEND_URL=http://127.0.0.1:5000
#
# Set these only when the browser should call a public backend directly
# (for example a separately exposed backend tunnel):
#   NEXT_PUBLIC_API_URL=https://<backend-tunnel>.devtunnels.ms
#   NEXT_PUBLIC_SOCKET_URL=https://<backend-tunnel>.devtunnels.ms
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
BACKEND_URL=http://127.0.0.1:5000
