# ─── Frontend (Next.js) environment ─────────────────────────────
# Public backend base URL used by the browser for API + Socket.io calls.
# Local dev:
#   NEXT_PUBLIC_API_URL=http://localhost:5000
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Remote dev tunnel (Dev Tunnels / ngrok): BOTH the frontend AND backend must
# be public HTTPS and the browser must be pointed at the PUBLIC backend URL,
# otherwise Chrome blocks the https->loopback request (Private Network Access).
#   NEXT_PUBLIC_API_URL=https://<backend-tunnel>.devtunnels.ms
#   NEXT_PUBLIC_SOCKET_URL=https://<backend-tunnel>.devtunnels.ms
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
