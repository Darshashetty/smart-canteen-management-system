PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_canteen
JWT_SECRET=smart_canteen_super_secret_jwt_key_2026
NODE_ENV=development

# Comma-separated allowed browser origins for CORS + Socket.io.
#   '*'                      -> allow all origins (dev convenience)
#   exact origins            -> https://app.example.com,http://localhost:3000
#   wildcard subdomains      -> https://*.devtunnels.ms,https://*.vercel.app
# For a remote dev tunnel set this to the FRONTEND tunnel origin, e.g.
#   CLIENT_ORIGIN=https://<frontend-tunnel>.devtunnels.ms
CLIENT_ORIGIN=*
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional operational timeouts (minutes).
# Precedence: CanteenSetting DB value (admin API) > these env vars > code defaults.
# AUTO_DELAY_GRACE_MINUTES: grace past estimated ready time before auto-flagging Delayed (default 5)
# UNCOLLECTED_TIMEOUT_MINUTES: minutes a Ready order may stay uncollected before Not Collected (default 60)
AUTO_DELAY_GRACE_MINUTES=5
UNCOLLECTED_TIMEOUT_MINUTES=60
